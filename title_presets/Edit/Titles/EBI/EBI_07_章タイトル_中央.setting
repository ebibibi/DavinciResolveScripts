{ Tools = ordered() {
Template = MacroOperator {
Inputs = ordered() {
StyledText = InstanceInput { Name = "Text / 本文", SourceOp = "MainText", Source = "StyledText", },
Font = InstanceInput { Name = "Font / フォント", SourceOp = "MainText", Source = "Font", },
Style = InstanceInput { Name = "Style / 書体", SourceOp = "MainText", Source = "Style", },
Size = InstanceInput { Name = "Text size / 文字サイズ", SourceOp = "MainText", Source = "Size", },
Red1 = InstanceInput { Name = "Text color / 文字色", ControlGroup = 1, SourceOp = "MainText", Source = "Red1", },
Green1 = InstanceInput { ControlGroup = 1, SourceOp = "MainText", Source = "Green1", },
Blue1 = InstanceInput { ControlGroup = 1, SourceOp = "MainText", Source = "Blue1", },
Center = InstanceInput { Name = "Position / 全体の位置", SourceOp = "Placement", Source = "Center", },
Scale = InstanceInput { Name = "Scale / 全体の大きさ", SourceOp = "Placement", Source = "Size", },
SubText = InstanceInput { Name = "Second line / 補足", SourceOp = "SubText", Source = "StyledText", },
SubFont = InstanceInput { Name = "Second font / 補足フォント", SourceOp = "SubText", Source = "Font", },
SubStyle = InstanceInput { Name = "Second style / 補足書体", SourceOp = "SubText", Source = "Style", },
SubSize = InstanceInput { Name = "Second size / 補足サイズ", SourceOp = "SubText", Source = "Size", },
CardRed = InstanceInput { Name = "Band color / 帯の色", ControlGroup = 2, SourceOp = "Card", Source = "TopLeftRed", },
CardGreen = InstanceInput { ControlGroup = 2, SourceOp = "Card", Source = "TopLeftGreen", },
CardBlue = InstanceInput { ControlGroup = 2, SourceOp = "Card", Source = "TopLeftBlue", },
CardAlpha = InstanceInput { Name = "Band opacity / 帯の濃さ", ControlGroup = 2, SourceOp = "Card", Source = "TopLeftAlpha", },
CardWidth = InstanceInput { Name = "Band width / 帯の幅", SourceOp = "CardMask", Source = "Width", },
CardHeight = InstanceInput { Name = "Band height / 帯の高さ", SourceOp = "CardMask", Source = "Height", },
},
Outputs = { MainOutput1 = InstanceOutput { SourceOp = "Placement", Source = "Output", }, },
Tools = ordered() {
MainText = TextPlus { Inputs = {
Width = Input { Value = 1920, },
Height = Input { Value = 1080, },
UseFrameFormatSettings = Input { Value = 1, },
StyledText = Input { Value = "次のステップへ", },
Font = Input { Value = "HGPSoeiKakugothicUB", },
Style = Input { Value = "Regular", },
Size = Input { Value = 0.072, },
Center = Input { Value = { 0.5, 0.54 }, },
VerticalJustificationNew = Input { Value = 3, },
HorizontalJustificationNew = Input { Value = 3, },
Red1 = Input { Value = 1, },
Green1 = Input { Value = 1, },
Blue1 = Input { Value = 1, },
Enabled2 = Input { Value = 0, },
Appearance2 = Input { Value = 1, },
Thickness2 = Input { Value = 0.025, },
Red2 = Input { Value = 0, },
Green2 = Input { Value = 0, },
Blue2 = Input { Value = 0, },
Enabled3 = Input { Value = 0, },
Enabled4 = Input { Value = 0, },
}, },
CardMask = RectangleMask { Inputs = {
MaskWidth = Input { Value = 1920, },
MaskHeight = Input { Value = 1080, },
PixelAspect = Input { Value = { 1, 1 }, },
UseFrameFormatSettings = Input { Value = 1, },
Center = Input { Value = { 0.5, 0.5 }, },
Width = Input { Value = 0.88, },
Height = Input { Value = 0.36, },
CornerRadius = Input { Value = 0.025, },
}, },
Card = Background { Inputs = {
Width = Input { Value = 1920, },
Height = Input { Value = 1080, },
UseFrameFormatSettings = Input { Value = 1, },
TopLeftRed = Input { Value = 0.025, },
TopLeftGreen = Input { Value = 0.04, },
TopLeftBlue = Input { Value = 0.065, },
TopLeftAlpha = Input { Value = 0.9, },
EffectMask = Input { SourceOp = "CardMask", Source = "Mask", },
}, },
MainOnCard = Merge { Inputs = {
PerformDepthMerge = Input { Value = 0, },
Background = Input { SourceOp = "Card", Source = "Output", },
Foreground = Input { SourceOp = "MainText", Source = "Output", },
}, },
SubText = TextPlus { Inputs = {
Width = Input { Value = 1920, },
Height = Input { Value = 1080, },
UseFrameFormatSettings = Input { Value = 1, },
StyledText = Input { Value = "ここから実際に操作します", },
Font = Input { Value = "HGPSoeiKakugothicUB", },
Style = Input { Value = "Regular", },
Size = Input { Value = 0.032, },
Center = Input { Value = { 0.5, 0.43 }, },
VerticalJustificationNew = Input { Value = 3, },
HorizontalJustificationNew = Input { Value = 3, },
Red1 = Input { Value = 0.65, },
Green1 = Input { Value = 0.8, },
Blue1 = Input { Value = 1, },
Enabled2 = Input { Value = 0, },
Appearance2 = Input { Value = 1, },
Thickness2 = Input { Value = 0.025, },
Red2 = Input { Value = 0, },
Green2 = Input { Value = 0, },
Blue2 = Input { Value = 0, },
Enabled3 = Input { Value = 0, },
Enabled4 = Input { Value = 0, },
}, },
WithSubtitle = Merge { Inputs = {
PerformDepthMerge = Input { Value = 0, },
Background = Input { SourceOp = "MainOnCard", Source = "Output", },
Foreground = Input { SourceOp = "SubText", Source = "Output", },
}, },
Placement = Transform { Inputs = {
Center = Input { Value = { 0.5, 0.5 }, },
Size = Input { Value = 1, },
Input = Input { SourceOp = "WithSubtitle", Source = "Output", },
}, },
},
},
}, ActiveTool = "Template", }
